# Copy to server/.env; do not commit real values.
NODE_ENV=production
PORT=5000
MONGO_URI=mongodb://username:password@127.0.0.1:27017/mydatabase?authSource=admin
CLIENT_ORIGIN=https://example.com
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-at-least-32-random-characters
# Set other integration credentials as required by enabled features (email, Instagram etc).
